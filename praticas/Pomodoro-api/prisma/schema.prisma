datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Settings {
  id              Int @id @default(autoincrement())
  workTime        Int
  shortBreakTime  Int
  longBreakTime   Int

  @@map("settings")
}

model Task {
  id            String   @id
  name          String
  duration      Int
  type          String
  startDate     BigInt
  completedDate BigInt?
  interruptDate BigInt?

  @@map("tasks")
}